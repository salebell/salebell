# Production public values (Vercel). For local development use .env.local.example instead.
# NEXT_PUBLIC_* values are public. Provider secrets live in Supabase Edge Function secrets.
# The optional managed relay enable flag below is private to the web server.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://salebell.example.com
NEXT_PUBLIC_DEPLOYMENT_MODE=cloud
NEXT_PUBLIC_SOURCE_URL=https://github.com/salebell/salebell
NEXT_PUBLIC_CLOUD_URL=https://salebell.vercel.app
NEXT_PUBLIC_COMPANY_NAME=Salebell
# Cloud analytics can be disabled. Self-hosted builds never load Vercel Analytics.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Optional private Supabase gateway URL used by the server-side webhook proxy.
SUPABASE_INTERNAL_URL=
# Optional: shown on /terms, /privacy and in the footer when set.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional compatible App Store/TestFlight distribution link in either deployment mode.
# Leave empty until the shared app and relay are qualified; source implementation is not publication.
NEXT_PUBLIC_IOS_APP_URL=
# Managed shared-app operator only; never set on customer/self-hosted websites.
# Requires operator-only deploy/relay/schema.sql, configured APNS_* secrets and push-relay deployment.
# Enabling this flag on managed Supabase also blocks ALL legacy direct APNs sends.
# See docs/PUSH_RELAY.md. Keep private; do not rename to NEXT_PUBLIC_*.
SALEBELL_PUSH_RELAY_ENABLED=false
# Legal details for /privacy, /terms and the footer. `npm run build` warns while they are missing.
NEXT_PUBLIC_COMPANY_NUMBER=
NEXT_PUBLIC_COMPANY_ADDRESS=
