# Server-only configuration on the canonical Salebell installer website.
# This identifies the shared Supabase OAuth application. Users authorize their own projects.
# Never copy these values to installing users' deployments or NEXT_PUBLIC_* fields.
INSTALLER_ENABLED=false
INSTALLER_PUBLIC_ENABLED=false
INSTALLER_ORIGIN=https://your-installer.example
INSTALLER_SUPABASE_CLIENT_ID=
INSTALLER_SUPABASE_CLIENT_SECRET=
# Generate with openssl rand -hex 32.
INSTALLER_ENCRYPTION_KEY=
# Canonical host's control database only; never an installing user's database.
INSTALLER_CONTROL_URL=https://your-control-project.supabase.co
INSTALLER_CONTROL_KEY=
# Full 40-character release commit and the actual native integration product slug.
INSTALLER_RELEASE_REF=
INSTALLER_SUPABASE_PRODUCT=
INSTALLER_CLEANUP_SECRET=
