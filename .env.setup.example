# Hosted owner setup only. Copy to .env.setup, fill the steps you need, then preview:
# npm run setup:owner -- --env-file .env.setup --check
# Apply selected steps interactively:
# npm run setup:owner -- --env-file .env.setup --steps auth,email
# Add --yes only for explicitly unattended setup. Blank steps are skipped in that mode.
# Values are dotenv data. Shell commands, substitutions and ~ expansion are not evaluated.
SUPABASE_PROJECT_REF=your_20_character_ref
SITE_URL=https://your-site.example
SUPABASE_ACCESS_TOKEN=

# Customer sign-in: verify your own sender domain in Resend first.
RESEND_API_KEY=
SENDER_EMAIL=

# Start with a Stripe test-mode key. Existing webhook signing secrets must be supplied on reruns.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Quote paths containing spaces. Use an absolute path, or ~/path (expanded by the push step).
APNS_KEY_FILE=
APNS_KEY_ID=
APPLE_TEAM_ID=
APNS_TOPIC=com.salebell.salebell
