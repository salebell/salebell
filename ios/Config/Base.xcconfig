// Shared build settings for the app, widget and tests.
// Owner: set DEVELOPMENT_TEAM to your 10-character Apple team id (Membership page
// at developer.apple.com) before building for a device or archiving.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

APP_BUNDLE_ID = com.salebell.salebell
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// Public values only. The publishable key is safe to ship; RLS protects data.
// `$()` keeps xcconfig from reading `//` as a comment.
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY = YOUR_INSTANCE_ANON_KEY
SITE_URL = http:/$()/localhost:3000

// The managed relay is shared by all runtime-selected backends. Do not override per customer.
PUSH_RELAY_URL = https:/$()/salebell.vercel.app/api/push-relay

// Override public backend values, bundle id and team for your own instance.
// Copy Local.xcconfig.example to Local.xcconfig; the local file is gitignored.
#include? "Local.xcconfig"
